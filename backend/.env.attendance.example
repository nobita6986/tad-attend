# Add these to the original Laravel .env after creating the Laravel project.
APP_TIMEZONE=UTC
ATTENDANCE_TIMEZONE=Asia/Ho_Chi_Minh
ATTENDANCE_IMAGE_RETENTION_DAYS=60
ATTENDANCE_COOLDOWN_SECONDS=60
# MUST match EXACT Core ML embedding model shipped on iPhone.
FACE_MODEL_ID=UNCONFIGURED
FACE_MODEL_VERSION=UNCONFIGURED
FACE_EMBEDDING_DIMENSIONS=512
# This number is not production-ready until FAR/FRR calibration is completed.
FACE_MATCH_THRESHOLD=0.75
SESSION_SECURE_COOKIE=true
