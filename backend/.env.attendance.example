# Add these to the original Laravel .env after creating the Laravel project.
APP_TIMEZONE=UTC
ATTENDANCE_TIMEZONE=Asia/Ho_Chi_Minh
ATTENDANCE_IMAGE_RETENTION_DAYS=60
ATTENDANCE_COOLDOWN_SECONDS=60
# MUST match EXACT face-embedding model shipped on kiosk devices (OpenCV Zoo SFace, Apache-2.0).
FACE_MODEL_ID=sface
FACE_MODEL_VERSION=2021dec
FACE_EMBEDDING_DIMENSIONS=128
# Starting cosine threshold for SFace; calibrate FAR/FRR during pilot before payroll use.
FACE_MATCH_THRESHOLD=0.42
SESSION_SECURE_COOKIE=true
